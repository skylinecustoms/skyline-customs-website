# Copy to .env and fill in. Never commit .env.

# --- Required for the site to run ---
NODE_ENV=production
PORT=3000
# MySQL connection string. Powers blog posts, gallery photos, monthly promos,
# promo slots/waitlist, site settings (announcement banner), and admin users.
DATABASE_URL=mysql://user:password@host:3306/skyline

# --- Lead capture (quote form, contact form, booking) ---
# GoHighLevel private integration token + location ID. The quote/contact forms
# create a GHL contact and send an SMS through the GHL conversations API.
GHL_API_KEY=
GHL_LOCATION_ID=

# --- Google reviews on /reviews (optional) ---
# Google Maps Platform key with the Places API enabled. Used server-side only,
# a few requests per day, to show the live rating, review count, and newest reviews.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=ChIJNW7sCXJFtokRVBtPKs11cNI

# --- Telegram admin bot (@skyline_minato_bot) ---
# Manages promo slots, gallery uploads, and the announcement banner via chat.
# Webhook URL to register with Telegram: https://<your-domain>/api/telegram/webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# --- AI Quote Assistant (floating chat widget) ---
# OpenAI-compatible chat completions endpoint. On Manus this was the built-in
# "Forge" API. Point it at any provider that speaks the /v1/chat/completions
# format, or leave blank to run the site without the AI assistant.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# --- Admin login (Manus OAuth) ---
# Only needed for protectedProcedure tRPC calls (blog create, promo addSlot).
# Public pages and the Telegram bot do not need these. Leave blank if you are
# not using Manus login.
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
JWT_SECRET=change-me-to-a-long-random-string

# --- Optional client-side keys ---
# Forge API used from the browser (Map component). Leave blank if unused.
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
